# Build staging & compiled artifacts
build/*
!build/lib/
!build/phases/
!build/tools/
dist/*
!dist/.gitkeep
app/gen/
web/generated/

# Track compressed core archive (<100 MB); ignore uncompressed raw binary
core/opencode
!core/opencode.tar.gz

# Python & Rust build caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
env/rust/agy-box/target/
env/rust/opencode-pty/target/
target/

# Logs, temporary & signature files
*.log
*.tmp
*.bak
*.swp
*~
*.idsig

# Operating System files
.DS_Store
Thumbs.db

# Sensitive credentials & private keystores
*.keystore
!tools/debug.keystore
*.jks
*.p12
*.key
*-token
keystore.env
.env.local

# Scratch / local workspaces
scratch/
