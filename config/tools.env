# OpenCode for Android — APK signing configuration.
# Production release key lives outside the repository in ~/.keys/signing.env
# or ~/.opencode-keystore/keystore.env (never committed).
# External contributors without signing.env fall back to a local
# ~/.android/debug.keystore generated on demand in 09-sign.sh.

_SIGN_ENV="${SIGNING_ENV:-}"
if [ -z "$_SIGN_ENV" ] && [ -f "$(dirname "$PROJECT")/.opencode-keystore/keystore.env" ]; then
    _SIGN_ENV="$(dirname "$PROJECT")/.opencode-keystore/keystore.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.config/opencode-keystore/keystore.env" ]; then
    _SIGN_ENV="$HOME/.config/opencode-keystore/keystore.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.keys/signing.env" ]; then
    _SIGN_ENV="$HOME/.keys/signing.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${USERPROFILE:-}" ]; then
    _UP_UNIX="$(printf '%s' "$USERPROFILE" | tr '\\' '/')"
    if [ -f "$_UP_UNIX/.keys/signing.env" ]; then
        _SIGN_ENV="$_UP_UNIX/.keys/signing.env"
    fi
fi

if [ -n "$_SIGN_ENV" ] && [ -f "$_SIGN_ENV" ]; then
    # shellcheck disable=SC1090
    . "$_SIGN_ENV"
    # Normalize opencode-keystore / antigravity variable formats
    KEYSTORE="${KEYSTORE:-${OC_RELEASE_KEYSTORE:-}}"
    KEY_ALIAS="${KEY_ALIAS:-${OC_RELEASE_KEY_ALIAS:-}}"
    KEY_PASS="${KEY_PASS:-${OC_RELEASE_KEY_PASS:-}}"
    STORE_PASS="${STORE_PASS:-${OC_RELEASE_STORE_PASS:-}}"
fi

KEYSTORE="${KEYSTORE:-${HOME:-.}/.android/debug.keystore}"
KEY_ALIAS="${KEY_ALIAS:-androiddebugkey}"
KEY_PASS="${KEY_PASS:-android}"
STORE_PASS="${STORE_PASS:-android}"
unset _SIGN_ENV _UP_UNIX

