# OpenCode for Android — application identity & SDK floor/ceiling.
# Consumed ONLY via build/tools/gen_android_config.py ->
#   res/values/gen.xml  +  com/oc/ide/BuildConfig.java
# and via build/lib/paths.sh for aapt --min-sdk-version / --target-sdk-version.
# Never hardcode these in AndroidManifest.xml or Java sources.
#
# NOTE: Both PKG (com.oc.ide) and PKG_DEV (com.oc.dev) are 10 ASCII bytes exact
# (matching len("com.termux") == 10), enabling zero-PRoot in-place ELF prefix
# rewriting across dpkg, bash, rg, and Termux shared libraries.

PKG=com.oc.ide
PKG_DEV=com.oc.dev
APP_NAME=OpenCode
APP_NAME_DEV=OpenCode Dev
VERSION_CODE=2040201
VERSION_NAME=2.4.2-r1
CORE_VERSION=2.4.2
PORT=45167
PORT_DEV=45168
OAUTH_SCHEME=opencode

# OpenCode v2.4.2 Bionic ARM64 is compiled with NDK r27c for Android API 28+.
# TARGET_SDK=28 MUST stay <= 28 so Android 10-16+ allows execve() directly from
# getFilesDir()/runtime/bin/opencode and getFilesDir()/usr/bin/* without W^X blocks.
MIN_API=28
TARGET_SDK=28
