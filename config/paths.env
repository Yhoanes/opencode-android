# OpenCode for Android — input tree locations (relative to $PROJECT, resolved by paths.sh).
# Build scratch paths live in build/lib/paths.sh; app identity lives in app.env.

CORE_DIR=core
CORE_BIN=core/opencode
CORE_CERTS_DIR=core/certs
CORE_SEED_DIR=core/seed
CORE_TOOLS_DIR=core/tools

WEB_DIR=web

ENV_DIR=env
ENV_BOOTSTRAP=env/bootstrap/bootstrap.tar.gz
ENV_OVERLAY_DIR=env/overlay
ENV_PKG_DIR=env/pkg

APP_SRC_DIR=app/src/main
TOOLS_DIR=tools
DIST_DIR=dist
